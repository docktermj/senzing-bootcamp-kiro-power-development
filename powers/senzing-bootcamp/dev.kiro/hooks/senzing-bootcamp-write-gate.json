{
  "version": "v1",
  "hooks": [
    {
      "name": "senzing-bootcamp-write-gate",
      "trigger": "PreToolUse",
      "matcher": "fs_write|str_replace|fs_append",
      "action": {
        "type": "command",
        "command": "\"<ABSOLUTE_PYTHON>\" \"<ABSOLUTE_SCRIPTS_DIR>/write-gate.py\""
      },
      "timeout": 15
    }
  ]
}
